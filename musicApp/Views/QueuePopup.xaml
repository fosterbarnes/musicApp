<UserControl x:Class="musicApp.Views.QueuePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:musicApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="380"
             Background="Transparent">
    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Polygon Grid.Row="0"
                 Points="0,10 10,0 20,10"
                 Fill="{StaticResource PanelBackground-brush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Stretch="None"
                 SnapsToDevicePixels="True"/>
        <Border x:Name="PopupBorder"
                Grid.Row="1"
                Background="{StaticResource PanelBackground-brush}"
                BorderBrush="{StaticResource BorderDefault-brush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6"
                Padding="{StaticResource PopupContentPadding-thk}"
                MinWidth="360">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,2,0,8"
                            HorizontalAlignment="Left">
                    <Button Style="{DynamicResource MaterialDesignToolButton}"
                            materialDesign:RippleAssist.IsDisabled="True"
                            Width="32" Height="32"
                            IsEnabled="False"
                            ToolTip="Add to queue">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{DynamicResource MaterialDesignToolButton}"
                            materialDesign:RippleAssist.IsDisabled="True"
                            Width="32" Height="32"
                            Margin="8,0,0,0"
                            ClickMode="Press"
                            ToolTip="Remove selected song from queue"
                            Click="QueueToolbarRemove_Click">
                        <materialDesign:PackIcon Kind="Minus" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{DynamicResource MaterialDesignToolButton}"
                            materialDesign:RippleAssist.IsDisabled="True"
                            Width="32" Height="32"
                            Margin="8,0,0,0"
                            ClickMode="Press"
                            ToolTip="Move selected song up"
                            Click="QueueToolbarMoveUp_Click">
                        <materialDesign:PackIcon Kind="ChevronUp" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{DynamicResource MaterialDesignToolButton}"
                            materialDesign:RippleAssist.IsDisabled="True"
                            Width="32" Height="32"
                            Margin="8,0,0,0"
                            ClickMode="Press"
                            ToolTip="Move selected song down"
                            Click="QueueToolbarMoveDown_Click">
                        <materialDesign:PackIcon Kind="ChevronDown" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <views:CompactUpcomingQueueList x:Name="UpcomingQueue"
                                                Grid.Row="1"
                                                EnableMultiSelect="True"/>

                <Grid Grid.Row="2" Height="1" Background="{StaticResource PanelBackground-brush}">
                    <Thumb x:Name="ResizeThumb"
                           Cursor="SizeNS"
                           DragDelta="ResizeThumb_DragDelta"
                           Height="13"
                           VerticalAlignment="Top"
                           Margin="0,0,0,-12"
                           IsHitTestVisible="True">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border Height="1" Background="{StaticResource BorderStrong-brush}" VerticalAlignment="Top"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
